{
  "name": "commonplace-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "dev": "pnpm --filter @commonplace/wiki dev",
    "build": "pnpm --filter @commonplace/wiki build",
    "preview": "pnpm --filter @commonplace/wiki preview",
    "content": "pnpm --filter @commonplace/wiki content",
    "build:personal": "pnpm --filter @commonplace/wiki build:personal",
    "typecheck": "pnpm --filter @commonplace/ui typecheck && pnpm --filter @commonplace/wiki typecheck",
    "verify": "pnpm skills:check && pnpm --filter @commonplace/ui typecheck && pnpm --filter @commonplace/wiki verify",
    "test:compat": "node tests/support/generate-page-audits.mjs && bddgen && playwright test",
    "test:demo": "WIKI_TEST_DEMO=1 pnpm test:compat",
    "skills:check": "node scripts/check-wiki-skills.mjs",
    "content:reset": "node scripts/reset-content.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.56.0",
    "playwright-bdd": "9.2.1"
  }
}
